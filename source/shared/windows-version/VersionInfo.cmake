include_guard(GLOBAL)
if(WIN32)
  enable_language(RC)
endif()

# Call after targets have been declared. Imported/vendor binaries are untouched.
function(psx_stamp_directory directory version)
  if(NOT WIN32)
    return()
  endif()
  if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+(\\.[0-9]+)?$")
    message(FATAL_ERROR "Windows file version must have three or four numeric components: ${version}")
  endif()
  string(REPLACE "." ";" components "${version}")
  list(LENGTH components component_count)
  if(component_count EQUAL 3)
    list(APPEND components 0)
  endif()
  foreach(component IN LISTS components)
    if(component GREATER 65535)
      message(FATAL_ERROR "Windows version component exceeds 65535: ${version}")
    endif()
  endforeach()
  string(JOIN "," PSX_VERSION_NUMERIC ${components})
  string(JOIN "." PSX_VERSION_STRING ${components})
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type "${target}" TYPE)
    get_target_property(imported "${target}" IMPORTED)
    get_target_property(stamped "${target}" PSX_VERSION_STAMPED)
    if(imported OR stamped OR NOT type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$")
      continue()
    endif()
    set(PSX_VERSION_FILETYPE VFT_DLL)
    if(type STREQUAL "EXECUTABLE")
      set(PSX_VERSION_FILETYPE VFT_APP)
    endif()
    set(PSX_VERSION_PRODUCT "ASS PSX Addons")
    set(PSX_VERSION_DESCRIPTION "${target}")
    set(PSX_VERSION_INTERNAL "${target}")
    get_target_property(binary_directory "${target}" BINARY_DIR)
    set(resource "${binary_directory}/windows-version/${target}.rc")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/version.rc.in" "${resource}" @ONLY)
    target_sources("${target}" PRIVATE "${resource}")
    set_property(TARGET "${target}" PROPERTY PSX_VERSION_STAMPED TRUE)
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  get_filename_component(workspace "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
  foreach(child IN LISTS children)
    # Independently built external libraries own their product/version resources.
    cmake_path(IS_PREFIX workspace "${child}" NORMALIZE is_project_source)
    if(is_project_source)
      psx_stamp_directory("${child}" "${version}")
    endif()
  endforeach()
endfunction()

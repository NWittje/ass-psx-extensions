#include <winver.h>
1 VERSIONINFO
 FILEVERSION @PSX_VERSION_NUMERIC@
 PRODUCTVERSION @PSX_VERSION_NUMERIC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @PSX_VERSION_FILETYPE@
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@PSX_VERSION_DESCRIPTION@\0"
   VALUE "FileVersion", "@PSX_VERSION_STRING@\0"
   VALUE "InternalName", "@PSX_VERSION_INTERNAL@\0"
   VALUE "ProductName", "@PSX_VERSION_PRODUCT@\0"
   VALUE "ProductVersion", "@PSX_VERSION_STRING@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END

include_guard(GLOBAL)
if(WIN32)
  enable_language(RC)
endif()

# Explicit application ownership keeps vendor libraries and unrelated tests untouched.
function(psx_target_icon target category)
  if(NOT category MATCHES "^(CO|DU|HW|IOS)$")
    message(FATAL_ERROR "Unknown PSX application icon: ${category}")
  endif()
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Icon target does not exist: ${target}")
  endif()
  get_target_property(imported "${target}" IMPORTED)
  get_target_property(type "${target}" TYPE)
  if(imported OR NOT type STREQUAL "EXECUTABLE")
    message(FATAL_ERROR "PSX icons apply only to owned executable targets: ${target}")
  endif()
  get_target_property(previous "${target}" PSX_APPLICATION_ICON_CATEGORY)
  if(previous)
    if(NOT previous STREQUAL category)
      message(FATAL_ERROR "Conflicting icons on ${target}: ${previous} / ${category}")
    endif()
    return()
  endif()
  set_property(TARGET "${target}" PROPERTY PSX_APPLICATION_ICON_CATEGORY "${category}")
  if(NOT WIN32)
    return()
  endif()
  set(PSX_ICON_FILE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${category}.ico")
  if(NOT EXISTS "${PSX_ICON_FILE}")
    message(FATAL_ERROR "Required application icon is missing: ${PSX_ICON_FILE}")
  endif()
  # Visual Studio does not implement OBJECT_DEPENDS. Reconfigure on ICO changes;
  # the content hash changes the generated RC even when its filename is unchanged.
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PSX_ICON_FILE}")
  file(SHA256 "${PSX_ICON_FILE}" PSX_ICON_SHA256)
  get_target_property(binary_directory "${target}" BINARY_DIR)
  # MSBuild places RC outputs in one IntDir, keyed by basename. A distinct
  # basename prevents collision with windows-version/<target>.rc.
  set(resource "${binary_directory}/windows-icons/${target}-application-icon.rc")
  configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/application-icon.rc.in" "${resource}" @ONLY)
  target_sources("${target}" PRIVATE "${resource}")
  target_include_directories("${target}" PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
endfunction()
